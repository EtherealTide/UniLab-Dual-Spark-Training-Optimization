+++ b/tests/test_launch_distributed.py
@@ -0,0 +1,56 @@
+from __future__ import annotations
+
+import pytest
+
+from scripts import launch_distributed
+
+
+def _args(*extra: str):
+    return launch_distributed._build_parser().parse_args(
+        [
+            "--algo",
+            "sac",
+            "--task",
+            "g1_walk_flat",
+            "--num-nodes",
+            "2",
+            "--ifname",
+            "enp1s0f1np1",
+            "--master-ip",
+            "10.77.0.1",
+            "--peer",
+            "10.77.0.2",
+            *extra,
+        ]
+    )
+
+
+def test_nccl_tcp_transport_keeps_compatibility_default() -> None:
+    assert launch_distributed._nccl_env(_args()) == {
+        "NCCL_SOCKET_IFNAME": "enp1s0f1np1",
+        "NCCL_IB_DISABLE": "1",
+    }
+
+
+def test_nccl_ib_transport_enables_rdma_and_peer_paths() -> None:
+    args = _args("--nccl-transport", "ib", "--nccl-ib-hca", "rocep1s0f1")
+    launch_distributed._validate(args)
+
+    assert launch_distributed._nccl_env(args) == {
+        "NCCL_SOCKET_IFNAME": "enp1s0f1np1",
+        "NCCL_IB_DISABLE": "0",
+        "NCCL_IB_HCA": "rocep1s0f1",
+        "NCCL_P2P_DISABLE": "0",
+        "NCCL_SHM_DISABLE": "0",
+    }
+
+
+def test_nccl_ib_transport_requires_hca() -> None:
+    with pytest.raises(SystemExit, match="--nccl-ib-hca"):
+        launch_distributed._validate(_args("--nccl-transport", "ib"))
+
+
+def test_nccl_auto_transport_only_pins_socket_interface() -> None:
+    assert launch_distributed._nccl_env(_args("--nccl-transport", "auto")) == {
+        "NCCL_SOCKET_IFNAME": "enp1s0f1np1"
+    }
