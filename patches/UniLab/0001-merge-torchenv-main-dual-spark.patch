+    assert len(term.reset_row_calls) == 1
+    torch.testing.assert_close(term.reset_row_calls[0], ids)
+    assert rows["policy"].shape == (len(ids), full["policy"].shape[1])
+    torch.testing.assert_close(rows["policy"], full["policy"][ids])
