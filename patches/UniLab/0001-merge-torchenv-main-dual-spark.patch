+
+def test_extract_legacy_mode_rejects_schema_stamped_summary(tmp_path: Path, capsys) -> None:
+    _write_run_summary(tmp_path)
+    _write_tfevents(tmp_path, {"perf/steps_per_sec": [100.0]})
