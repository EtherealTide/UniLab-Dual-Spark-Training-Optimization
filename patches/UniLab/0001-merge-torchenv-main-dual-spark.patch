+    entries = tuple(entry.strip() for entry in (raw or "").split(",") if entry.strip())
+    if len(entries) != world_size:
+        return
+    if len(entries) <= 1:
+        return
+    global _DP_PARENT_VISIBLE_ENTRIES
+    _DP_PARENT_VISIBLE_ENTRIES = entries
