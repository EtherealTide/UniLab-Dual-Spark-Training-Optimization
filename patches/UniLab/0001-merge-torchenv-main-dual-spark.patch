+        "<geom type='box' size='0.1 0.1 0.1' contype='0' conaffinity='0'/>"
+        "</body></body></worldbody><actuator><motor name='motor' joint='joint' "
+        "ctrlrange='-1 1'/></actuator></mujoco>"
+    )
+    scene = SceneCfg(
+        model_file=str(model),
