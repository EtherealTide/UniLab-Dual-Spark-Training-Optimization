+        run_command=_fake_commands(),
+    )
+
+    assert evidence.manifest() == {
+        "configured": "mps",
+        "effective": "mps",
+        "validated": True,
+        "learner_device": "cuda:0",
+        "collector_device": "cuda:0",
+        "learner_gpu_uuid": "A",
+        "collector_gpu_uuid": "A",
