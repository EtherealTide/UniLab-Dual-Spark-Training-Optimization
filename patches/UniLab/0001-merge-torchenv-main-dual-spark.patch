+        if version != _SUPPORTED_METRIC_SCHEMA_VERSION:
+            raise MetricSchemaError(
+                f"unsupported metric_schema_version {version!r}; expected "
+                f"{_SUPPORTED_METRIC_SCHEMA_VERSION}"
