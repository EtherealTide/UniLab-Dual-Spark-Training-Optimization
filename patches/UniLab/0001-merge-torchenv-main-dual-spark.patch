+        robot_pos,
+        motion_quat,
+        robot_quat,
+        motion_lin,
+        robot_lin,
+        motion_ang,
+        robot_ang,
+        relative_pos,
+        relative_quat,
+        motion_joint_pos,
+        robot_joint_pos,
+        motion_joint_vel,
+        robot_joint_vel,
+    )
+    expected = (
+        np.linalg.norm(motion_pos[:, anchor_body_idx] - robot_pos[:, anchor_body_idx], axis=-1),
+        np.sqrt(
