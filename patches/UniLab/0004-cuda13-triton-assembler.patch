diff --git a/tests/test_launch_distributed.py b/tests/test_launch_distributed.py
index e739e203..e22da1db 100644
--- a/tests/test_launch_distributed.py
+++ b/tests/test_launch_distributed.py
@@ -1,7 +1,10 @@
 from __future__ import annotations
 
-import pytest
+import base64
+import json
+import shlex
 
+import pytest
 from scripts import launch_distributed
 
 
@@ -54,3 +57,43 @@ def test_nccl_auto_transport_only_pins_socket_interface() -> None:
     assert launch_distributed._nccl_env(_args("--nccl-transport", "auto")) == {
         "NCCL_SOCKET_IFNAME": "enp1s0f1np1"
     }
+
+
+def test_ptxas_override_reaches_ssh_worker(monkeypatch, tmp_path) -> None:
+    path = tmp_path / "custom CUDA" / "ptxas"
+    path.parent.mkdir()
+    path.touch(mode=0o755)
+    monkeypatch.setenv("TRITON_PTXAS_PATH", str(path))
+    tokens = shlex.split(launch_distributed._peer_ssh_command(_args(), 1, "logs/probe"))
+    spec = json.loads(base64.b64decode(tokens[-1]))
+    assert spec["env"]["TRITON_PTXAS_PATH"] == str(path)
+    env = launch_distributed._rank_environment(spec["env"], 1)
+    assert env["TRITON_PTXAS_PATH"] == str(path)
+
+
+def test_rank_selects_installed_cuda13_assembler(monkeypatch, tmp_path) -> None:
+    path = tmp_path / "ptxas"
+    path.touch(mode=0o755)
+    monkeypatch.delenv("TRITON_PTXAS_PATH", raising=False)
+    monkeypatch.setattr(launch_distributed, "_SPARK_PTXAS", path)
+    assert launch_distributed._rank_environment({}, 1)["TRITON_PTXAS_PATH"] == str(path)
+
+
+def test_explicit_ptxas_takes_precedence_over_autodetection(monkeypatch, tmp_path) -> None:
+    path = tmp_path / "ptxas"
+    path.touch(mode=0o755)
+    monkeypatch.setattr(launch_distributed, "_SPARK_PTXAS", tmp_path / "missing")
+    env = launch_distributed._rank_environment({"TRITON_PTXAS_PATH": str(path)}, 0)
+    assert env["TRITON_PTXAS_PATH"] == str(path)
+
+
+@pytest.mark.parametrize("path", ["relative/ptxas", "/missing/cuda/ptxas"])
+def test_invalid_ptxas_override_fails_before_training(path) -> None:
+    with pytest.raises(SystemExit, match="absolute executable path"):
+        launch_distributed._rank_environment({"TRITON_PTXAS_PATH": path}, 1)
+
+
+def test_host_without_cuda13_keeps_triton_default(monkeypatch, tmp_path) -> None:
+    monkeypatch.delenv("TRITON_PTXAS_PATH", raising=False)
+    monkeypatch.setattr(launch_distributed, "_SPARK_PTXAS", tmp_path / "missing")
+    assert "TRITON_PTXAS_PATH" not in launch_distributed._rank_environment({}, 0)
