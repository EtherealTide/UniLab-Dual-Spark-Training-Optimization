+def _start_local(cmd: list[str], env: dict[str, str]) -> subprocess.Popen:
+    """Preserve the existing logger's TTY detection without touching the user's TTY."""
+    if not sys.stdout.isatty():
+        return subprocess.Popen(
+            cmd,
+            env=env,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            start_new_session=True,
+        )
+    import fcntl
+    import pty
+    import struct
+    import termios
+
+    master, slave = pty.openpty()
+    try:
+        size = shutil.get_terminal_size()
+        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", size.lines, size.columns, 0, 0))
+        settings = termios.tcgetattr(slave)
+        # The outer terminal handles LF->CRLF; avoid translating twice.
+        settings[1] &= ~termios.OPOST
+        termios.tcsetattr(slave, termios.TCSANOW, settings)
+        proc = subprocess.Popen(
+            cmd,
+            env=env,
+            stdin=subprocess.DEVNULL,
+            stdout=slave,
+            stderr=subprocess.STDOUT,
+            start_new_session=True,
+        )
+        proc.stdout = os.fdopen(master, "rb", buffering=0)
+        return proc
+    except BaseException:
+        os.close(master)
+        raise
+    finally:
+        os.close(slave)
+
