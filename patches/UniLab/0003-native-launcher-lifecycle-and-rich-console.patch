+@pytest.mark.skipif(os.name != "posix", reason="POSIX PTY")
+def test_rank0_uses_isolated_output_terminal_with_original_rich_logger(tmp_path, monkeypatch):
+    import queue
+    import shutil
+    from types import SimpleNamespace
+
+    monkeypatch.setattr(launch.sys, "stdout", SimpleNamespace(isatty=lambda: True))
+    monkeypatch.setattr(shutil, "get_terminal_size", lambda: os.terminal_size((120, 48)))
+    code = """
+import os,sys
+from rich.console import Console
+from rich.live import Live
+from rich.panel import Panel
+console = Console()
+assert console.is_terminal and console.width == 120
+assert not sys.stdin.isatty()
+with Live(Panel('existing logger display'), console=console, auto_refresh=False) as live:
+    live.update(Panel('original Rich final panel'), refresh=True)
+print('clean EOF', flush=True)
+"""
+    proc = launch._start_local([sys.executable, "-u", "-c", code], dict(os.environ))
+    errors = queue.SimpleQueue()
+    path = tmp_path / "rank0.log"
+    pump = launch._pump(proc, path, False, errors)
+    try:
+        assert proc.wait(timeout=10) == 0
+        pump.join(timeout=5)
+        assert not pump.is_alive() and errors.empty()
+        data = path.read_bytes()
+        assert b"original Rich final panel" in data and b"clean EOF" in data
+        assert b"\x1b[?25l" in data and b"\x1b[?25h" in data
+        assert b"\r\r\n" not in data
+    finally:
+        launch._stop_group(proc)
