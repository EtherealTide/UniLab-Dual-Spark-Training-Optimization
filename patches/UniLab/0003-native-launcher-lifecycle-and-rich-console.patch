+@pytest.mark.skipif(os.name != "posix", reason="POSIX process groups")
+@pytest.mark.parametrize("failing_rank,exit_code", [(0, 7), (1, 7), (1, 0)])
+def test_failure_stops_peer_and_reports_error(
+    tmp_path: Path, monkeypatch, capsys, failing_rank: int, exit_code: int
+) -> None:
+    fake_ssh = tmp_path / "ssh"
+    # Use a Python stand-in which executes the actual quoted remote command.
+    fake_ssh.write_text(
+        "#!"
+        + sys.executable
+        + "\nimport os,sys\nassert '-tt' not in sys.argv\nos.execvp('sh',['sh','-c',sys.argv[-1]])\n"
+    )
+    fake_ssh.chmod(0o755)
+    monkeypatch.setenv("PATH", str(tmp_path) + os.pathsep + os.environ["PATH"])
+    args = launch._build_parser().parse_args(
+        [
+            "--algo",
+            "sac",
+            "--task",
+            "g1_walk_flat",
+            "-N",
+            "2",
+            "--peer",
+            "fake",
+            "--ifname",
+            "eth0",
+            "--master-ip",
+            "10.0.0.1",
+        ]
+    )
+
+    args.completion_timeout = 0.2
+
+    def command(args, rank, log_dir, python):
+        if rank == failing_rank:
+            code = f"import time; time.sleep(0.3); print('injected rank failure',flush=True); raise SystemExit({exit_code})"
+        else:
+            code = f"import os,time; from pathlib import Path; Path({str(tmp_path / f'rank{rank}.pid')!r}).write_text(str(os.getpid())); time.sleep(60)"
+        return [sys.executable, "-u", "-c", code], {}
+
+    monkeypatch.setattr(launch, "_rank_command", command)
+
+    def remote(args, rank, log_dir):
+        cmd, _ = command(args, rank, log_dir, sys.executable)
+        return shlex.join(
+            [
+                sys.executable,
+                str(Path(launch.__file__)),
+                "--worker-spec",
+                spec(cmd, tmp_path / "remote"),
+            ]
+        )
+
+    monkeypatch.setattr(launch, "_peer_ssh_command", remote)
+    started = time.monotonic()
+    assert launch._launch_multi(args, str(tmp_path / "local")) == (exit_code or 1)
+    assert time.monotonic() - started < 12
+    pid = int((tmp_path / f"rank{1 - failing_rank}.pid").read_text())
+    with pytest.raises(ProcessLookupError):
+        os.kill(pid, 0)
+    output = capsys.readouterr().out
+    assert ("injected rank failure" if exit_code else "peers did not finish") in output
+    assert "Final statistics" not in output
+    assert (
+        "injected rank failure" in (tmp_path / f"local/launcher/rank{failing_rank}.log").read_text()
+    )
+
