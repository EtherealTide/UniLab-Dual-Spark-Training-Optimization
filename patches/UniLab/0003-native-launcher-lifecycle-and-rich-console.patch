+"""CPU-only regression coverage for real pipes and rank process lifetimes."""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import shlex
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+from scripts import launch_distributed as launch
+
+
+def spec(command: list[str], root: Path) -> str:
+    return base64.b64encode(
+        json.dumps(
+            {
+                "cmd": command,
+                "env": {},
+                "rank": 1,
+                "log_dir": str(root),
+            }
+        ).encode()
+    ).decode()
+
+
+def wait_path(path: Path) -> None:
+    deadline = time.monotonic() + 5
+    while not path.exists():
+        assert time.monotonic() < deadline
+        time.sleep(0.05)
+
+
+@pytest.mark.skipif(os.name != "posix", reason="POSIX process groups")
+@pytest.mark.parametrize("stop", ["lease", "signal"])
+def test_worker_disconnect_reaps_training_group(tmp_path: Path, stop: str) -> None:
+    pidfile = tmp_path / "child.pid"
+    command = [
+        sys.executable,
+        "-u",
+        "-c",
+        f"import os,time; from pathlib import Path; Path({str(pidfile)!r}).write_text(str(os.getpid())); print('worker live',flush=True); time.sleep(60)",
+    ]
+    worker = subprocess.Popen(
+        [sys.executable, str(Path(launch.__file__)), "--worker-spec", spec(command, tmp_path)],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    try:
+        wait_path(pidfile)
+        pid = int(pidfile.read_text())
+        assert worker.stdin is not None
+        if stop == "lease":
+            worker.stdin.close()
+        else:
+            worker.terminate()
+        assert worker.wait(timeout=10) == 143
+        with pytest.raises(ProcessLookupError):
+            os.kill(pid, 0)
+        assert "worker live" in (tmp_path / "launcher/rank1.log").read_text()
+    finally:
+        if worker.poll() is None:
+            worker.kill()
+
