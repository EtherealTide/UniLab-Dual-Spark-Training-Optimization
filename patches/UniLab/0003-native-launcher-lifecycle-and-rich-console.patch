+def _pump(
+    proc: subprocess.Popen,
+    path: Path,
+    show: bool,
+    errors: queue.SimpleQueue,
+) -> threading.Thread:
+    logfile = path.open("xb", buffering=0)
+
+    def copy() -> None:
+        assert proc.stdout is not None
+        try:
+            read = getattr(proc.stdout, "read1", proc.stdout.read)
+            while True:
+                try:
+                    chunk = read(65536)
+                except OSError as exc:
+                    # Linux PTY masters report EIO once their last slave closes.
+                    if exc.errno == errno.EIO and os.isatty(proc.stdout.fileno()):
+                        break
+                    raise
+                if not chunk:
+                    break
+                logfile.write(chunk)
+                if show:
+                    sys.stdout.buffer.write(chunk)
+                    sys.stdout.buffer.flush()
+        except Exception as exc:
+            errors.put(exc)
+        finally:
+            logfile.close()
+            proc.stdout.close()
+
+    thread = threading.Thread(target=copy, daemon=True)
+    thread.start()
+    return thread
+
