+        ),
+        _spec(
+            "Train/mean_reward",
+            "collector",
+            "reward units",
+            "latest mean of raw environment returns for the most recent 100 completed episodes",
+            "Upstream-RSL-RL-compatible episode return; excludes timeout-bootstrap corrections.",
