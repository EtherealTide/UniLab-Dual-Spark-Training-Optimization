+    if device_type != "mps":
+        return False
+    try:
+        from torch.utils._foreach_utils import (  # pyright: ignore[reportPrivateImportUsage]
+            _get_fused_kernels_supported_devices,
+        )
+    except ImportError:
+        return False
+    return device_type in _get_fused_kernels_supported_devices()
