+def test_fast_sac_fuses_critic_and_alpha_dp_with_independent_loss_flags(monkeypatch):
+    learner = _small_fast_sac_learner()
+    learner._device_type = "cuda"  # Exercise graph-safe DP math with CPU tensors.
+    learner._host_finite_checks = False
+    for parameter in learner.qnet.parameters():
+        parameter.grad = torch.ones_like(parameter)
+    learner.log_alpha.grad = torch.ones_like(learner.log_alpha)
+    synchronized: list[torch.Tensor] = []
+
+    def average(parameters):
+        synchronized.extend(parameters)
+        assert synchronized[-2] is learner._critic_gradient_loss_flag
+        assert synchronized[-1] is learner._alpha_gradient_loss_flag
+        # Model the other rank reporting the inverse validity state. Both
+        # optimizers must therefore observe a global non-finite condition.
+        synchronized[-2].grad.add_(1.0).div_(2)
+        synchronized[-1].grad.add_(1.0).div_(2)
+
+    learner.set_gradient_sync(average)
+    assert learner._fuse_critic_alpha_dp() is True
+    learner._sync_critic_alpha_gradients(
+        torch.tensor(float("inf")),
+        torch.tensor(1.0),
+    )
+
+    q_parameters = list(learner.qnet.parameters())
+    assert len(synchronized[:-3]) == len(q_parameters)
+    assert all(
+        actual is expected
+        for actual, expected in zip(synchronized[:-3], q_parameters, strict=True)
+    )
+    assert synchronized[-3] is learner.log_alpha
+    monkeypatch.setattr(
+        torch,
+        "_amp_foreach_non_finite_check_and_unscale_",
+        lambda *_args: None,
+    )
+    learner._arm_optimizer_finite_gate(
+        learner.q_optimizer,
+        torch.tensor(float("inf")),
+        loss_flag=learner._critic_gradient_loss_flag,
+    )
+    assert learner._optimizer_found_inf.item() > 0
+    learner._arm_optimizer_finite_gate(
+        learner.alpha_optimizer,
+        torch.tensor(1.0),
+        loss_flag=learner._alpha_gradient_loss_flag,
+    )
+    assert learner._optimizer_found_inf.item() > 0
+
+
