+def test_gradient_graph_warmup_binds_persistent_bucket_views(tmp_path: Path, monkeypatch):
+    reduced = []
+
+    def fake_all_reduce(tensor, **_kwargs):
+        reduced.append(tensor)
+        tensor.mul_(2.0)
+
+    monkeypatch.setattr("uni_rl.ipc.dp_sync.dist.all_reduce", fake_all_reduce)
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    sync = DpParameterSync(
+        world_size=2, rank=0, rendezvous_path=str(tmp_path / "unused"), backend="gloo"
+    )
+    first = torch.nn.Parameter(torch.ones(3))
+    second = torch.nn.Parameter(torch.full((2,), 2.0))
+    first.grad = torch.full_like(first, 3.0)
+    second.grad = torch.full_like(second, 4.0)
+
+    sync.begin_gradient_graph_capture(enable_timing=False)
+    sync.allreduce_gradients((first, second))
+
+    assert len(reduced) == 1
+    packed = reduced[0]
+    assert first.grad is not None and first.grad.data_ptr() == packed.data_ptr()
+    assert second.grad is not None
+    assert second.grad.data_ptr() == packed[3:].data_ptr()
+    assert torch.equal(first.grad, torch.full_like(first, 3.0))
+    assert torch.equal(second.grad, torch.full_like(second, 4.0))
+
+
