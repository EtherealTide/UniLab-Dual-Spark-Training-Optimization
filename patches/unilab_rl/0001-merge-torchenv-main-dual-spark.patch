+def test_cuda_inference_ring_ipc_events_cross_process() -> None:
+    spawn_context = mp.get_context("spawn")
+    result_queue = spawn_context.Queue()
+    ring = SharedInferenceRing(
+        num_envs=2,
+        obs_dim=3,
+        action_dim=2,
+        device="cuda",
+        capacity=2,
+        epoch=0,
