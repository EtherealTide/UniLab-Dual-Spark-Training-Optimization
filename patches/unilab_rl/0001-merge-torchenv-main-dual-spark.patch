+        action_dim=_ACTION_DIM,
+        device="cuda",
+        ingress_slot_rows=4,
+        ingress_device="cuda",
+    )
+    try:
+        for slot in buf._ingress_slots:
+            monkeypatch.setattr(slot, "cpu", fail_ingress_read)
+            monkeypatch.setattr(slot, "item", fail_ingress_read)
+            protected_ingress_slots.append(slot)
