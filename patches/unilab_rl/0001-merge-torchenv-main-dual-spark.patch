+LOGGER_OWNED_METRICS = frozenset(
+    tag
+    for tag, spec in METRIC_SPECS.items()
+    if spec.owner == "collector"
+    or tag
+    in {
+        "Train/iteration",
+        "Perf/total_fps",
+        "Perf/iteration_time",
+        "Perf/learning_time",
+    }
