+    try:
+        observations = torch.empty((2, 3), device="cuda")
+        dones = torch.empty(2, device="cuda")
+        for tick in range(3):
+            ring.copy_observation_to(
+                tick_id=tick,
+                observations=observations,
+                dones=dones,
+                epoch=0,
+            )
