+
+        assert (start, count) == (0, 4)
+        torch.testing.assert_close(packed[:, buf._obs_sl], batch[0])
+        torch.testing.assert_close(packed[:, buf._act_sl], batch[1])
+        assert len(current_stream_devices) == 1
+    finally:
