# Copy to config/cluster.env and edit for your cluster. This file is not sourced
# from Git so local hostnames and paths do not need to be committed.
HOST0=nvidia@192.168.110.48
HOST1=nvidia@192.168.110.40
MASTER_ADDR=10.77.0.1
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
REMOTE_ROOT=/home/nvidia/unilab-dual-spark-repro
MAX_ITERATIONS=500
# Optional console settings; environment overrides take precedence.
# CONSOLE_MODE=compact
# PROGRESS_INTERVAL=30
# Optional assembler override, forwarded to both ranks. CUDA 13.0 is selected
# automatically on each Spark when /usr/local/cuda-13.0/bin/ptxas is installed.
# TRITON_PTXAS_PATH=/usr/local/cuda-13.0/bin/ptxas
